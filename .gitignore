node_modules/
data/
.DS_Store
npm-debug.log*
*.log

# Secrets. Only .env.example is committed; every other .env variant stays local.
# The live server's .env holds SESSION_SECRET, SITE_HOST and SITE_IP.
.env
.env.*
!.env.example

# SQLite databases (the live DB lives on a Docker volume, but never commit a copy)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Keys and certificates
*.pem
*.key
*.crt
*.p12
id_rsa*
id_ed25519*

# Editor / tooling
.cursor/
.vscode/
.idea/

# Downloaded at build time by scripts/fetch-assets.sh
assets/avatars/
