# Copy to .env and adjust. docker-compose reads this file if present.

PORT=3000

# Signs session cookies. Change this: altering it logs everyone out.
SESSION_SECRET=please-change-me-to-something-random

# SQLite file. Inside Docker this lives on the named volume.
DB_PATH=./data/plugdj.db

# Shown in the room header.
ROOM_NAME=The Basement

# Uncomment to expose /avatar-lab, the avatar rig tuning page.
# AVATAR_LAB=1
